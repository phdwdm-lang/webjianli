# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# CDP Chrome profile (keep out of Turbopack watch to avoid LOCK file panic)
.chrome-cdp
# AI 辅助生成产物与临时状态(与锦鲤/新功能无关,不入库)
/.superpowers/
/generated-images/
